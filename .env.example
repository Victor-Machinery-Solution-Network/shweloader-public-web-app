# ─────────────────────────────────────────────────────────────────────────────
# ShweLoader public website — environment
# Copy to .env.local for local dev. Set the same keys in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin of THIS website (no trailing slash).
# Used for <link canonical>, OG urls, sitemap.xml, robots.txt, JSON-LD.
NEXT_PUBLIC_SITE_URL="https://shweloader.com.mm"

# App REST API (the Hono Cloudflare Worker). Server-side only — never exposed to
# the browser. Used by SSR/ISR reads AND the same-origin /api/listings proxy that
# powers Browse's client-side filtering (so the browser never calls the worker
# directly — no CORS dependency). Production URL is UNKNOWN as of 2026-06-01;
# staging is the only confirmed origin.
APP_API_BASE_URL="https://app-api.staging.shweloader.com.mm"

# R2 / CDN base for listing + blog images. Public (used to build next/image src).
NEXT_PUBLIC_ASSET_BASE_URL="https://asset-staging.shweloader.com.mm"

# ── Optional ────────────────────────────────────────────────────────────────

# Pusher (live support chat realtime). Leave blank to fall back to polling.
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Shared secret for the on-demand ISR revalidation webhook (/api/revalidate).
REVALIDATE_SECRET=""
